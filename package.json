{
  "name": "yesplaymusic",
  "version": "0.6.1",
  "private": true,
  "description": "A third party music player for Netease Music",
  "author": "qier222<qier222@outlook.com>",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build:renderer": "vite build",
    "dev:tauri:renderer": "IS_TAURI=true vite",
    "build:tauri:renderer": "IS_TAURI=true vite build",
    "tauri": "tauri",
    "dev:tauri": "tauri dev --target aarch64-apple-darwin",
    "build:tauri": "tauri build --target aarch64-apple-darwin && bun run sign:tauri:local",
    "build:tauri:release": "tauri build --target aarch64-apple-darwin --bundles dmg --ci",
    "sign:tauri:local": "bun scripts/sign-tauri-local.mjs",
    "package:tauri:dmg": "bun scripts/package-tauri-dmg.mjs",
    "collect:tauri:release-dmg": "bun scripts/package-tauri-dmg.mjs --collect-release",
    "verify:tauri:release-env": "bun scripts/verify-apple-release-env.mjs",
    "verify:tauri:version": "bun scripts/verify-tauri-version.mjs",
    "smoke:tauri": "bun scripts/smoke-tauri-local.mjs",
    "smoke:tauri:core": "bun scripts/smoke-tauri-local.mjs --core-only",
    "build:sidecar": "mkdir -p src-tauri/binaries && bun build src/sidecar.js --compile --target=bun-darwin-arm64 --outfile src-tauri/binaries/yesplaymusic-sidecar-aarch64-apple-darwin",
    "test": "bun test",
    "build:electron": "electron-vite build",
    "postinstall": "npm_execpath= electron-builder install-app-deps",
    "postuninstall": "npm_execpath= electron-builder install-app-deps",
    "prettier": "npx prettier --write ./src",
    "netease_api:run": "npx @neteaseapireborn/api",
    "build:app": "npm_execpath= electron-vite build && npm_execpath= electron-builder --mac -p never",
    "build:mac": "npm_execpath= electron-vite build && npm_execpath= electron-builder --mac -p never",
    "build:win": "npm_execpath= electron-vite build && npm_execpath= electron-builder --win -p never",
    "build:linux": "npm_execpath= electron-vite build && npm_execpath= electron-builder --linux -p never"
  },
  "main": "out/main/background.js",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neteaseapireborn/api": "^4.29.7",
    "@tauri-apps/api": "^2.11.1",
    "@unblockneteasemusic/rust-napi": "^0.4.0",
    "axios": "^0.26.1",
    "change-case": "^4.1.2",
    "cli-color": "^2.0.0",
    "color": "^4.2.3",
    "core-js": "^3.6.5",
    "crypto-js": "^4.0.0",
    "dayjs": "^1.8.36",
    "dexie": "^3.0.3",
    "discord-rich-presence": "^0.0.8",
    "electron-context-menu": "^3.1.2",
    "electron-debug": "^3.1.0",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^4.3.0",
    "electron-store": "^8.0.1",
    "electron-updater": "^5.0.1",
    "esbuild": "^0.20.1",
    "express": "^4.17.1",
    "express-fileupload": "^1.2.0",
    "express-http-proxy": "^1.6.2",
    "extract-zip": "^2.0.1",
    "howler": "^2.2.3",
    "js-cookie": "^2.2.1",
    "jsbi": "^4.1.0",
    "lodash": "^4.17.20",
    "md5": "^2.3.0",
    "mpris-service": "^2.1.2",
    "music-metadata": "^7.5.3",
    "node-vibrant": "^3.2.1-alpha.1",
    "nprogress": "^0.2.0",
    "pac-proxy-agent": "^4.1.0",
    "plyr": "^3.6.2",
    "qrcode": "^1.4.4",
    "tunnel": "^0.0.6",
    "vscode-codicons": "^0.0.17",
    "vue": "^3",
    "vue-i18n": "^11",
    "vue-router": "^4",
    "vue-slider-component": "^4.1.0-beta.7",
    "vuex": "^4",
    "x11": "^2.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^17.0.0",
    "@vitejs/plugin-vue": "^6",
    "@vue/compiler-sfc": "^3",
    "babel-eslint": "^10.1.0",
    "electron": "^43",
    "electron-builder": "^23.0.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^6.7.2",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-vue": "^7.9.0",
    "fast-glob": "^3.3.3",
    "husky": "^4.3.0",
    "prettier": "2.5.1",
    "sass": "^1.26.11",
    "vite": "^7",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "resolutions": {
    "icon-gen": "3.0.0",
    "degenerator": "2.2.0",
    "electron-builder": "^23.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true
    },
    "extends": [
      "plugin:vue/essential",
      "plugin:vue/recommended",
      "plugin:prettier/recommended",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "globals": {
      "ipcRenderer": "off"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "packageManager": "bun@1.3.12"
}
